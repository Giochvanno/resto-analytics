# Максимальный размер загружаемого файла, МБ
RESTO_MAX_UPLOAD_MB=10

# Путь к TOML с настройками сводки (группы, источник суммы и т.д.).
# Если не задан — используется config/summary.toml, а если и его нет — значения по умолчанию.
RESTO_SUMMARY_CONFIG=config/summary.toml

# Уровень логов: DEBUG, INFO, WARNING, ERROR
RESTO_LOG_LEVEL=INFO

# --- Telegram-бот ---
# Токен от @BotFather (https://t.me/BotFather → /newbot). Никому не показывайте и не коммитьте.
RESTO_BOT_TOKEN=

# Кому можно пользоваться ботом: Telegram ID через запятую.
# Первый запуск — оставьте пустым: бот никого не пустит, но покажет ваш ID в ответ на /start.
RESTO_BOT_ALLOWED_USERS=
